{
  "name": "@acme/order-service",
  "version": "2.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src"
  },
  "dependencies": {
    "express": "4.19.2",
    "zod": "3.23.8",
    "drizzle-orm": "0.30.10",
    "pino": "9.0.0"
  },
  "devDependencies": {
    "typescript": "5.4.5",
    "vitest": "1.6.0",
    "supertest": "7.0.0",
    "eslint": "8.57.0",
    "prettier": "3.2.5"
  }
}
